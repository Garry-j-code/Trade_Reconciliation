{
  "Comment": "Weekday recon: one Lambda Task that POSTs /api/recon/run through CloudFront.",
  "StartAt": "RunRecon",
  "States": {
    "RunRecon": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${TriggerFunctionArn}",
        "Payload": {
          "action": "recon"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 1,
          "BackoffRate": 1
        }
      ],
      "End": true
    }
  }
}
