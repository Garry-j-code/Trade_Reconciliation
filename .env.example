# Massive (formerly Polygon.io) — either key name works
MASSIVE_API_KEY=
# POLYGON_API_KEY=

# Optional: upload Parquet cache to S3 after local write
# (boto3 uses the normal AWS credential chain: env vars, ~/.aws/credentials, etc.)
# Create a dedicated bucket, e.g. trade-recon-market-data-<yourname>-8948-us-east-1
# S3_CACHE_BUCKET=trade-recon-market-data-example-us-east-1
# S3_CACHE_PREFIX=market-data
# Match the bucket's region
# AWS_REGION=us-east-1
# Optional named profile (boto3 / AWS CLI pick this up from the env)
# AWS_PROFILE=trade-recon-8948

# Optional overrides (defaults are fine for local step 1)
# MARKET_DATA_CACHE_DIR=backend/data/cache
# MARKET_DATA_LOOKBACK_DAYS=730

# Synthetic trade output (step 2)
# TRADE_OUTPUT_DIR=backend/data/generated

# Normalization output (step 3)
# NORMALIZED_OUTPUT_DIR=backend/data/normalized

# Matcher output (step 4)
# MATCHED_OUTPUT_DIR=backend/data/matched

# Postgres (step 3). Default path is AWS RDS; set DATABASE_URL so
# `uv run normalize-trades` also loads raw + normalized rows.
# Local docker-compose is an emergency-only fallback, not the primary DB.
# DATABASE_URL=postgresql+psycopg://recon:YOUR_RDS_PASSWORD@trade-recon-postgres.xxxxx.us-east-1.rds.amazonaws.com:5432/trade_recon
# Optional local fallback: docker compose up -d
# DATABASE_URL=postgresql+psycopg://recon:recon@localhost:5432/trade_recon

# Local FastAPI (step 5). `uv run serve-api`
# API_HOST=127.0.0.1
# API_PORT=8000
# RECON_TIMEOUT_SECONDS=120
# Local dashboard without Cognito (hosted API always verifies JWT):
# AUTH_DISABLED=true
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=us-east-1
# RECON_SCHEDULER_SECRET=

# Agent / Bedrock (step 6). Default credential chain; project profile is trade-recon-8948.
# AGENT_LLM_PROVIDER=bedrock
# AGENT_EMBED_PROVIDER=bedrock
# Current default: Amazon Nova Lite (cost). No Anthropic use-case form required.
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Later comparison: us.anthropic.claude-sonnet-4-5-20250929-v1:0
# (Sonnet 4.5 cross-region inference profile; raw anthropic.claude-sonnet-4-5-… fails ResourceNotFoundException.)
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v1
# AWS_REGION=us-east-1
# AWS_PROFILE=trade-recon-8948

# CDK / CloudFront (step 8). After frontend deploy, allow the distribution on the local API:
# CORS_ALLOW_ORIGINS=https://dxxxxxxxxxxxx.cloudfront.net
# CLOUDFRONT_ORIGIN=https://dxxxxxxxxxxxx.cloudfront.net
# Optional build-time API base for the static UI (leave empty for Vite proxy locally
# and for CloudFront same-origin /api + /health):
# VITE_API_BASE=http://EIP:80
# Hosted API stores DATABASE_URL in SSM /trade-recon/database-url (not in CDK):
#   AWS_PROFILE=trade-recon-8948 uv run python infra/ec2_api/put_database_url.py
