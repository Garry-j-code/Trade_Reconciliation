# Synthetic trades (regenerate with generate-trades; S3/cache is source of truth)
backend/data/generated/*
!backend/data/generated/.gitkeep

# Normalized trades (regenerate with normalize-trades)
backend/data/normalized/*
!backend/data/normalized/.gitkeep

# Matcher output (regenerate with match-trades)
backend/data/matched/*
!backend/data/matched/.gitkeep

